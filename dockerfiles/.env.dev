# Preset values for the vela dev environment (see: https://github.com/HorizenOfficial/vela/tree/main/dockerfiles)

# Ethereum JSON-RPC endpoint (protocol/host/port match vela's naming)
CHAIN_RPC_PROTOCOL='http'
CHAIN_RPC_ADDRESS='host.docker.internal'
CHAIN_RPC_PORT='8545'

# Facilitator wallet private key (hex, with or without 0x prefix).
# This account pays gas for all submitted requests.
# (Anvill default account number 8)
FACILITATOR_PRIVATE_KEY=0xdbda1821b80551c9d65939329250298aa3472ba22feea921c0cf5d620ea67b97

# ProcessorEndpoint contract address (0x...)
CHAIN_PROCESSOR_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9

# ---- Optional ----

# Max ETH (in wei) sent as msg.value for service fees (default: 50)
# MAX_FEE_VALUE=50

# vela-nova application ID for x402 payments (default: 1)
VELA_NOVA_APPLICATION_ID=1

# HTTP server port (default: 3000)
# PORT=3000

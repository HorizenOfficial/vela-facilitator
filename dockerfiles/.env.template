# ---- Required ----

# Ethereum JSON-RPC endpoint (protocol/host/port match vela's naming)
CHAIN_RPC_PROTOCOL=
CHAIN_RPC_ADDRESS=
CHAIN_RPC_PORT=

# Facilitator wallet private key (hex, with or without 0x prefix).
# This account pays gas for all submitted requests.
FACILITATOR_PRIVATE_KEY=

# ProcessorEndpoint contract address (0x...)
CHAIN_PROCESSOR_ADDRESS=

# ---- Optional ----

# Max ETH (in wei) sent as msg.value for service fees (default: 50)
# MAX_FEE_VALUE=50

# vela-nova application ID for x402 payments (default: 1)
# VELA_NOVA_APPLICATION_ID=1

# HTTP server port (default: 3000)
# PORT=3000
